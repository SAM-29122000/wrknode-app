# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/wrknode"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

NEXTAUTH_URL="http://localhost:3000"

# Razorpay — from https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID is not secret (it's used client-side by the checkout
# widget too), but keep it here for convenience.
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."

# From the webhook you create at https://dashboard.razorpay.com/app/webhooks
# pointing to <your-domain>/api/razorpay/webhook, subscribed to
# payment.captured. This is a separate secret from RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET="..."

# --- Job application agent (see README "Job application agent" section) ---

# Free API keys: developer.adzuna.com and jooble.org/api/about
ADZUNA_APP_ID="..."
ADZUNA_APP_KEY="..."
# Comma-separated Adzuna country codes to search across ("in and outside
# India"). Adzuna/Jooble don't support OR in search text (it narrows
# results instead of broadening them), so each phrase below is queried
# separately per country — countries x phrases = calls per run. Keep both
# lists short on a free API tier.
ADZUNA_COUNTRIES="in,gb,us"
JOOBLE_API_KEY="..."
JOOBLE_LOCATION=""
JOB_AGENT_SEARCH_TERMS="purchase engineer,procurement SAP,supply chain logistics,import export"

# The discover run (job search + drafting) only actually does anything
# between these IST hours — a cron ping outside the window is a no-op.
# Doesn't affect check-replies or daily-summary, which should run all day.
JOB_AGENT_WINDOW_START_HOUR="8"
JOB_AGENT_WINDOW_END_HOUR="12"

# Any long random string — the external cron pinging /api/job-agent/discover,
# /api/job-agent/check-replies, and /api/job-agent/daily-summary must send
# this back as the x-cron-secret header, or those routes reject the request.
JOB_AGENT_CRON_SECRET="replace-with-a-random-string"

# Gemini — aistudio.google.com/apikey (free tier, no billing required —
# used instead of OpenAI since OpenAI needs prepaid credits). GEMINI_MODEL
# defaults to an alias ("-latest") rather than a pinned version, since
# Google has deprecated specific dated model names more than once.
GEMINI_API_KEY="..."
GEMINI_MODEL="gemini-flash-lite-latest"

# Twilio WhatsApp — console.twilio.com (free sandbox to start)
TWILIO_ACCOUNT_SID="..."
TWILIO_AUTH_TOKEN="..."
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
JOB_AGENT_WHATSAPP_TO="whatsapp:+917998103343"

# Gmail — OAuth client from Google Cloud Console (Desktop app type),
# refresh token minted once via developers.google.com/oauthplayground
# using your own client ID/secret with gmail.send + gmail.readonly scopes.
GMAIL_CLIENT_ID="..."
GMAIL_CLIENT_SECRET="..."
GMAIL_REFRESH_TOKEN="..."
