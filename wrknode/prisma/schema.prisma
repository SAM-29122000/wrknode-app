// Wrknode — Database Schema (Prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth.js (NextAuth) required tables ---
// These four models are the standard shape Auth.js expects when using
// a database adapter. Don't rename fields — Auth.js reads them directly.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CLIENT)
  createdAt     DateTime  @default(now())

  // Bcrypt hash for email/password (Credentials) login. Not part of the
  // Auth.js adapter contract — added for this app's own auth flow.
  password String?

  accounts Account[]
  sessions Session[]
  requests ClientRequest[]
}

enum Role {
  ADMIN // you
  CLIENT // someone you're building automation for
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Your actual business data ---
// One client can submit multiple requests over time (new project,
// follow-up work, a change to something already built).

model ClientRequest {
  id          String        @id @default(cuid())
  userId      String
  message     String        @db.Text
  status      RequestStatus @default(NEW)
  region      Region        @default(INDIA)
  quotedPrice Int? // in smallest currency unit (paise or cents)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Set once Stripe confirms payment for this request's quotedPrice.
  paidAt                  DateTime?
  stripeCheckoutSessionId String?   @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum RequestStatus {
  NEW
  QUOTED
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

enum Region {
  INDIA
  INTERNATIONAL
}
